{
  "name": "claude-time-machine",
  "version": "0.6.0",
  "private": true,
  "description": "A Claude Code mod: every Claude turn becomes a snapshot you can review, undo or travel back to.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test tests/*.spec.ts",
    "test:mod": "claude plugin test .",
    "validate": "claude plugin validate . --strict",
    "types": "claude -p --plugin-dir . \"/tm help\"",
    "typecheck": "tsc -p .",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "bench": "node scripts/bench.ts",
    "sandbox": "node scripts/sandbox.ts",
    "check": "npm run lint && npm test && npm run validate && npm run test:mod && npm run typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  }
}
